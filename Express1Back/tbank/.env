TBANK_API_BASE_URL=https://securepay.tinkoff.ru/v2/Init

# Public base URL of your project (used to build default callback URLs)
BILLING_PUBLIC_BASE_URL=https://express1.ru

# Optional explicit callback URLs (if empty, generated from BILLING_PUBLIC_BASE_URL)
TBANK_NOTIFICATION_URL=
TBANK_SUCCESS_URL=
TBANK_FAIL_URL=

# Where the user is redirected after success/fail callback
TBANK_SUCCESS_FALLBACK_URL=https://express1.ru/wallet-screen.html?payment=success
TBANK_FAIL_FALLBACK_URL=https://express1.ru/wallet-screen.html?payment=fail

# Admin protection for /api/admin/*
ADMIN_API_KEY=change_me

# Public sales access mode:
# public     - open
# admin_key  - require x-api-key: ADMIN_API_KEY
# disabled   - return 404 for public /api/sales*
PUBLIC_SALES_MODE=public

# Seed demo products on first start if products table empty
SEED_DEMO_PRODUCTS=true

# Fallback attempts for subscription payloads without explicit amount
SUBSCRIPTION_WEEK_ATTEMPTS=1000
SUBSCRIPTION_MONTH_ATTEMPTS=5000
SUBSCRIPTION_YEAR_ATTEMPTS=25000
